{
  "appId": "com.wirecut.app",
  "appName": "WireCut",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#F6F8FC",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F6F8FC"
    },
    "Keyboard": {
      "resize": "body"
    }
  },
  "android": {
    "backgroundColor": "#F6F8FC"
  },
  "ios": {
    "contentInset": "automatic"
  }
}
